{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conversational-ai.local/schemas/cube-query.v1.schema.json",
  "title": "Automotive Cube Query v1",
  "description": "Constrained, source-independent request for read-only automotive catalog analytics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "model", "measures", "dimensions", "filters"],
  "properties": {
    "version": { "const": 1 },
    "model": { "const": "automotive_catalog" },
    "mode": { "enum": ["aggregate", "records"] },
    "measures": {
      "type": "array",
      "items": {
        "enum": [
          "part_count",
          "manufacturer_count",
          "total_cost_usd",
          "average_cost_usd",
          "min_cost_usd",
          "max_cost_usd",
          "total_weight_kg",
          "average_weight_kg",
          "min_weight_kg",
          "max_weight_kg"
        ]
      },
      "minItems": 0,
      "maxItems": 1
    },
    "dimensions": {
      "type": "array",
      "items": {
        "enum": [
          "manufacturer",
          "commodity",
          "sub_commodity",
          "vehicle_program",
          "region",
          "country",
          "plant",
          "model_year",
          "lifecycle_status",
          "active",
          "category",
          "material",
          "supplier_status",
          "cost_usd",
          "weight_kg",
          "document_version"
        ]
      },
      "uniqueItems": true,
      "maxItems": 5
    },
    "fields": {
      "type": "array",
      "items": {
        "enum": [
          "part_number",
          "part_name",
          "description",
          "commodity",
          "sub_commodity",
          "manufacturer",
          "vehicle_program",
          "region",
          "country",
          "plant",
          "model_year",
          "material",
          "lifecycle_status",
          "supplier_status",
          "cost_usd",
          "weight_kg",
          "active",
          "document_version",
          "created_at",
          "updated_at",
          "category"
        ]
      },
      "minItems": 1,
      "maxItems": 25,
      "uniqueItems": true
    },
    "filters": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "operator", "value"],
        "properties": {
          "field": {
            "enum": [
              "manufacturer",
              "commodity",
              "sub_commodity",
              "vehicle_program",
              "region",
              "country",
              "plant",
              "model_year",
              "lifecycle_status",
              "active",
              "category",
              "material",
              "supplier_status",
              "cost_usd",
              "weight_kg",
              "document_version",
              "description",
              "created_at",
              "updated_at",
              "part_number",
              "part_name"
            ]
          },
          "operator": {
            "enum": ["equals", "in", "contains", "gt", "gte", "lt", "lte"]
          },
          "value": {
            "oneOf": [
              { "type": "string", "maxLength": 256 },
              { "type": "number" },
              { "type": "boolean" },
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "items": {
                  "oneOf": [
                    { "type": "string", "maxLength": 256 },
                    { "type": "number" },
                    { "type": "boolean" }
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "order_by": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "direction"],
        "properties": {
          "field": {
            "enum": [
              "part_count",
              "manufacturer_count",
              "total_cost_usd",
              "average_cost_usd",
              "min_cost_usd",
              "max_cost_usd",
              "total_weight_kg",
              "average_weight_kg",
              "min_weight_kg",
              "max_weight_kg",
              "manufacturer",
              "commodity",
              "sub_commodity",
              "vehicle_program",
              "region",
              "country",
              "plant",
              "model_year",
              "lifecycle_status",
              "active",
              "category",
              "material",
              "supplier_status",
              "cost_usd",
              "weight_kg",
              "document_version",
              "part_number",
              "part_name",
              "description",
              "created_at",
              "updated_at"
            ]
          },
          "direction": { "enum": ["asc", "desc"] }
        }
      }
    },
    "limit": { "type": "integer", "minimum": 1, "maximum": 500 }
  }
}
