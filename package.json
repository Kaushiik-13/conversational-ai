{
  "name": "conversational-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Conversational analytics product: NestJS API, web app, Cube Query and semantic layer",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "concurrently --names API,WEB --prefix-colors blue,green \"npm run start:dev --workspace=@automotive-search/api\" \"npm run start --workspace=@automotive-search/web\"",
    "dev:api": "npm run start:dev --workspace=@automotive-search/api",
    "dev:web": "npm run start --workspace=@automotive-search/web",
    "db:migrate": "node --env-file=.env database/migrations/migrate.mjs",
    "db:seed": "node --env-file=.env database/seeds/seed.mjs",
    "db:bootstrap:accounts": "node --env-file=.env database/seeds/bootstrap-development-accounts.mjs",
    "db:generate:catalog": "node --env-file=.env database/generators/generate-catalog.mjs --count 5000000",
    "db:generate:catalog:smoke": "node --env-file=.env database/generators/generate-catalog.mjs --smoke",
    "db:validate:phase3": "node --env-file=.env database/validation/phase3-foundations.mjs",
    "db:validate:phase4": "node --env-file=.env database/validation/phase4-reference-data.mjs",
    "db:validate:phase5": "node --env-file=.env database/validation/phase5-authentication.mjs",
    "db:validate:phase6": "node --env-file=.env database/validation/phase6-authorization.mjs",
    "db:validate:phase7": "node --env-file=.env database/validation/phase7-generator.mjs",
    "db:validate:phase7:smoke": "node --env-file=.env database/validation/phase7-generator.mjs --smoke",
    "db:validate:phase8": "node --env-file=.env database/validation/phase8-search.mjs",
    "db:validate:phase9": "node --env-file=.env database/validation/phase9-application-api.mjs",
    "db:validate:phase11": "node --env-file=.env database/validation/phase11-security.mjs",
    "db:validate:phase11:clean": "node database/validation/phase11-clean-install.mjs",
    "eval:conversation": "node --env-file=../.env scripts/evaluate-conversation.mjs",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:api:e2e": "npm run test:e2e --workspace=@automotive-search/api",
    "lint": "npm run lint --workspace=@automotive-search/api && prettier --check .",
    "lint:fix": "npm run lint:fix --workspace=@automotive-search/api && npm run format",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.8.1"
  }
}
