# Copy this file to .env. Keep passwords private and never commit .env.
COMPOSE_PROJECT_NAME=conversational-ai
DB_HOST_PORT=5433

POSTGRES_DB=automotive_search
POSTGRES_USER=automotive_owner
POSTGRES_PASSWORD=replace_with_the_existing_automotive_owner_password
APP_DATABASE_USER=automotive_app
APP_DATABASE_PASSWORD=replace_with_the_existing_automotive_app_password

API_PORT=3000
WEB_PORT=4200
WEB_NEXT_PORT=4300
OLLAMA_MODEL=qwen3.5:2b
CONVERSATION_LLM_PROVIDER=ollama
ACCESS_TOKEN_SECRET=replace_with_at_least_32_random_bytes
REFRESH_TOKEN_SECRET=replace_with_a_different_32_random_bytes
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300
COOKIE_SECURE=false
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_IDLE_TTL_SECONDS=604800
REFRESH_ABSOLUTE_TTL_SECONDS=2592000
LOGIN_ACCOUNT_LIMIT=5
LOGIN_IP_LIMIT=20
LOGIN_WINDOW_SECONDS=900

# Development-only account bootstrap. Use unique passwords of at least 16 characters.
DEV_GLOBAL_ADMIN_PASSWORD=replace_with_a_unique_16_plus_character_password
DEV_ORG_A_ADMIN_PASSWORD=replace_with_a_unique_16_plus_character_password
DEV_ORG_B_ADMIN_PASSWORD=replace_with_a_unique_16_plus_character_password
DEV_ORG_C_ADMIN_PASSWORD=replace_with_a_unique_16_plus_character_password
DEV_ORG_D_ADMIN_PASSWORD=replace_with_a_unique_16_plus_character_password
DEV_ORG_B_RESTRICTED_PASSWORD=replace_with_a_unique_16_plus_character_password
DEV_ORG_A_ANALYST_PASSWORD=replace_with_a_unique_16_plus_character_password
DEV_ORG_A_VIEWER_PASSWORD=replace_with_a_unique_16_plus_character_password
DEV_ORG_B_ANALYST_PASSWORD=replace_with_a_unique_16_plus_character_password
DEV_ORG_B_VIEWER_PASSWORD=replace_with_a_unique_16_plus_character_password
DEV_ORG_C_ANALYST_PASSWORD=replace_with_a_unique_16_plus_character_password
DEV_ORG_C_VIEWER_PASSWORD=replace_with_a_unique_16_plus_character_password
DEV_ORG_D_ANALYST_PASSWORD=replace_with_a_unique_16_plus_character_password
DEV_ORG_D_VIEWER_PASSWORD=replace_with_a_unique_16_plus_character_password

# Keep this on D: when Docker's PostgreSQL data is stored on D:.
DISK_GUARD_HOST_PATH=./.data/disk-guard
